# ============================================================
#  Конфигурация бота FeelFilm для ВКонтакте
#  Скопируйте этот файл в .env и заполните значения.
# ============================================================

# --- ВКонтакте ---------------------------------------------
# Токен сообщества (Управление → Работа с API → Ключи доступа).
# Нужны права: Wall (стена) и Photos (фотографии).
VK_TOKEN=
# Числовой ID сообщества БЕЗ минуса (узнать: vk.com/club<ID> или через vk.com/dev).
VK_GROUP_ID=
VK_API_VERSION=5.199

# --- Источник новостей (Kinopoisk) -------------------------
# Тот же ключ, что и в backend приложения.
KINOPOISK_API_KEY=
KINOPOISK_API_BASE=https://kinopoiskapiunofficial.tech

# --- ИИ-генерация текста -----------------------------------
# template  — без внешнего ИИ, аккуратный пост из данных (работает сразу).
# openai    — OpenAI-совместимый API (OpenAI, OpenRouter, GigaChat-прокси, Ollama…).
AI_PROVIDER=template
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.8

# --- Расписание --------------------------------------------
# times    — публиковать в указанные часы каждый день.
# interval — публиковать раз в INTERVAL_HOURS часов.
SCHEDULE_MODE=times
POST_TIMES=10:00,16:00,20:00
INTERVAL_HOURS=6
TIMEZONE=Europe/Moscow
# Опубликовать сразу при запуске демона (true/false).
POST_ON_START=false

# --- Контент -----------------------------------------------
# Какие типы постов чередовать: premiere, recommendation, collection, fact.
CONTENT_TYPES=premiere,recommendation,fact
# Значение с # и пробелами обязательно в кавычках, иначе dotenv обрежет по #.
HASHTAGS="#FeelFilm #кино #чтопосмотреть"
# Призыв к действию в конце поста (перед хэштегами). Пусто = без призыва.
CTA="📲 Скачивайте приложение FeelFilm, чтобы найти свой фильм: https://www.rustore.ru/catalog/app/com.feelfilm.app"
# Не публиковать фильмы с рейтингом ниже (0 = не фильтровать).
MIN_RATING=0
# Добавлять ссылку на трейлер в текст поста.
ATTACH_TRAILER_LINK=true

# --- Логи и хранилище (можно не менять) --------------------
LOG_LEVEL=INFO
# Пути по умолчанию: vk_bot/data/… (создаются автоматически).
# POSTED_STORE_PATH=
# LOG_FILE=
REQUEST_TIMEOUT_SECONDS=20
